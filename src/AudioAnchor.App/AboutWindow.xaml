<Window x:Class="AudioAnchor.App.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="About AudioAnchor" Icon="Assets/icon.ico" Width="360" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14" ShowInTaskbar="False" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" AutomationProperties.AutomationId="AboutWindow">
  <!-- An explicit opaque Background disables Fluent's default translucent Mica backdrop, which
       otherwise shows the desktop wallpaper's color through a small window's generous margins. -->
  <StackPanel Margin="28,26">
    <!-- The 1254x1254 PNG downscaled, not icon.ico: picking one small embedded ico frame (e.g. 64x64)
         still looks blurry once Windows DPI scaling rescales it again to physical pixels. -->
    <Image Source="Assets/logo.png" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,14" RenderOptions.BitmapScalingMode="HighQuality"/>
    <TextBlock Text="AudioAnchor" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
    <TextBlock x:Name="VersionText" FontSize="13" HorizontalAlignment="Center" Margin="0,2,0,14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="AboutVersionText"/>
    <TextBlock Text="Keep your sound where it belongs." HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"/>
    <TextBlock HorizontalAlignment="Center" Margin="0,0,0,10">
      <Hyperlink Click="RepositoryLinkClicked">github.com/rm968211/audio-anchor</Hyperlink>
    </TextBlock>
    <TextBlock Text="Free for noncommercial use under the PolyForm Noncommercial License 1.0.0." FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
    <TextBlock Text="Copyright rm968211." FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,22"/>
    <Button Content="Close" Padding="20,8" MinHeight="34" HorizontalAlignment="Center" Click="CloseClicked" IsDefault="True" IsCancel="True" AutomationProperties.AutomationId="AboutCloseButton"/>
  </StackPanel>
</Window>
